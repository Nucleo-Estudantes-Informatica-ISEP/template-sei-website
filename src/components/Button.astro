---
import type { HTMLAttributes } from "astro/types";

type BaseProps = {
  variant: "primary" | "secondary" | "ghost";
};

type Props =
  | (BaseProps & { href: string } & Omit<HTMLAttributes<"a">, "href">)
  | (BaseProps & { href?: never } & Omit<HTMLAttributes<"button">, "href">);

const { variant, href, class: className, ...attrs } = Astro.props;

const classes = ["btn", `btn-${variant}`, className].filter(Boolean).join(" ");
---

{
  href ? (
    <a
      href={href}
      class={classes}
      {...(attrs as Omit<HTMLAttributes<"a">, "href" | "class">)}
    >
      <slot />
    </a>
  ) : (
    <button
      type="button"
      class={classes}
      {...(attrs as Omit<HTMLAttributes<"button">, "href" | "class" | "type">)}
    >
      <slot />
    </button>
  )
}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    cursor: pointer;
    text-decoration: none;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.2;
    border: 1px solid transparent;
  }

  .btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .btn-primary {
    background: var(--color-accent);
    color: #fff;
    border-radius: 999px;
    padding: 12px 26px;
  }
  .btn-primary:hover {
    background: var(--color-accent-600);
  }
  .btn-primary:active {
    background: var(--color-accent-700);
  }

  .btn-secondary {
    background: transparent;
    color: var(--color-accent-700);
    border-color: var(--color-accent-700);
    border-radius: 0;
    padding: 15px 28px;
  }
  .btn-secondary:hover {
    background: color-mix(in srgb, var(--color-accent-700) 8%, transparent);
  }
  .btn-secondary:active {
    background: color-mix(in srgb, var(--color-accent-700) 16%, transparent);
  }

  .btn-ghost {
    background: transparent;
    color: var(--color-accent-700);
    padding: 0;
  }
  .btn-ghost::after {
    content: "\2192"; /* → */
    display: inline-block;
    transition: transform 0.15s ease;
  }
  .btn-ghost:hover {
    color: var(--color-accent-800);
  }
  .btn-ghost:hover::after {
    transform: translateX(3px);
  }

  .btn-icon {
    width: 36px;
    height: 36px;
    padding: 0;
    border-radius: 999px;
  }
</style>
