---
import { getRelativeLocaleUrl } from "astro:i18n";
import { site } from "../data/site";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { NAV_LINKS } from "../i18n/routes";
import LanguageSwitcher from "./LanguageSwitcher.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentPath = Astro.url.pathname
  .replace(new RegExp(`^/${lang}/?`), "")
  .replace(/\/$/, "");
const registrationHref =
  site.links.registration ??
  getRelativeLocaleUrl(lang, site.pages.registration);
const isHome = currentPath === site.pages.home;
---

<nav class:list={["site-nav", { "site-nav--home": isHome }]}>
  <div class="site-nav-inner">
    <a href={getRelativeLocaleUrl(lang, "")} class="site-nav-brand">
      <img
        src={site.images.logo}
        alt={site.edition.name}
        width="26"
        height="26"
      />
      {site.edition.name}
    </a>
    <div class="site-nav-links">
      {
        NAV_LINKS.map((link) => (
          <a
            href={getRelativeLocaleUrl(lang, site.pages[link.id])}
            aria-current={
              site.pages[link.id] === currentPath ? "page" : undefined
            }
          >
            {t(link.labelKey)}
          </a>
        ))
      }
    </div>
    <div class="site-nav-actions">
      <LanguageSwitcher />
      <a href={registrationHref} class="site-nav-cta">
        {t("nav.registration")}
      </a>
    </div>
  </div>
</nav>

<style>
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    padding: var(--space-6) var(--space-8);
    transition: transform 0.3s ease-in-out;
  }

  .site-nav--home {
    /* No solid background, allowing hero to go behind */
  }

  .site-nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(39.6px);
    -webkit-backdrop-filter: blur(39.6px);
    border: 1px solid #e2e2e5;
    border-radius: 999px;
    padding: 10px 12px 10px 24px;
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.05),
      var(--shadow-sm);
    max-width: 1440px;
    margin: 0 auto;
  }

  .site-nav--home .site-nav-inner {
    /* Use the same translucent background as other pages */
  }

  .site-nav-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--color-accent-900);
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: 17px;
    letter-spacing: 0.01em;
  }

  .site-nav-links {
    display: flex;
    gap: 30px;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }

  .site-nav-links a {
    color: var(--color-neutral-700);
    text-decoration: none;
  }

  .site-nav-links a:hover,
  .site-nav-links a[aria-current="page"] {
    color: var(--color-accent-900);
    font-weight: 800;
  }

  .site-nav-actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .site-nav-cta {
    display: inline-flex;
    align-items: center;
    padding: 12px 26px;
    background: var(--color-accent);
    color: #fff;
    border-radius: 999px;
    text-decoration: none;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .site-nav-cta:hover {
    background: var(--color-accent-600);
  }

  @media (max-width: 900px) {
    .site-nav {
      padding: var(--space-4) var(--space-4);
    }
    
    .site-nav-inner {
      gap: 16px;
      padding: 8px 12px 8px 16px;
    }
    
    .site-nav-links {
      display: none; /* Hide links on mobile for now, assuming a mobile menu is needed later */
    }
  }
</style>

<script>
  let lastScroll = 0;
  const nav = document.getElementById("site-nav");

  if (nav) {
    window.addEventListener(
      "scroll",
      () => {
        const currentScroll = window.pageYOffset;

        if (currentScroll <= 0) {
          nav.style.transform = "translateY(0)";
          return;
        }

        if (currentScroll > lastScroll && currentScroll > 80) {
          // Scroll Down
          nav.style.transform = "translateY(-100%)";
        } else {
          // Scroll Up
          nav.style.transform = "translateY(0)";
        }
        lastScroll = currentScroll;
      },
      { passive: true }
    );
  }
</script>
