---
import { getRelativeLocaleUrl } from "astro:i18n";
import { site } from "../data/site";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { NAV_LINKS } from "../i18n/routes";
import LanguageSwitcher from "./LanguageSwitcher.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentPath = Astro.url.pathname
  .replace(new RegExp(`^/${lang}/?`), "")
  .replace(/\/$/, "");
const registrationHref =
  site.links.registration ??
  getRelativeLocaleUrl(lang, site.pages.registration);
const isHome = currentPath === site.pages.home;
---

<nav id="site-nav" class:list={["site-nav", { "site-nav--home": isHome }]}>
  <div class="site-nav-inner">
    <a href={getRelativeLocaleUrl(lang, "")} class="site-nav-brand">
      <img
        src={site.images.logo}
        alt={site.edition.name}
        width="26"
        height="26"
      />
      {site.edition.name}
    </a>
    <div class="site-nav-links">
      {
        NAV_LINKS.map((link) => (
          <a
            href={getRelativeLocaleUrl(lang, site.pages[link.id])}
            aria-current={
              site.pages[link.id] === currentPath ? "page" : undefined
            }
          >
            {t(link.labelKey)}
          </a>
        ))
      }
    </div>
    <div class="site-nav-actions">
      <LanguageSwitcher />
      <details class="site-nav-menu">
        <summary aria-label={t("nav.menu")}>
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <div class="site-nav-menu-panel">
          {
            NAV_LINKS.map((link) => (
              <a
                href={getRelativeLocaleUrl(lang, site.pages[link.id])}
                aria-current={
                  site.pages[link.id] === currentPath ? "page" : undefined
                }
              >
                {t(link.labelKey)}
              </a>
            ))
          }

          <a
            href={registrationHref}
            aria-current={!site.links.registration &&
            site.pages.registration === currentPath
              ? "page"
              : undefined}
          >
            {t("nav.registration")}
          </a>
        </div>
      </details>

      <a
        href={registrationHref}
        class="site-nav-cta"
        aria-current={!site.links.registration &&
        site.pages.registration === currentPath
          ? "page"
          : undefined}
      >
        {t("nav.registration")}
      </a>
    </div>
  </div>
</nav>

<style>
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    padding: var(--space-6) var(--space-8);
    transition: transform 0.3s ease-in-out;
  }

  .site-nav--home {
    /* No solid background, allowing hero to go behind */
    /* Reserves space for Home's above-the-fold dates ticker (#85), which
       is the same fixed height (var(--space-10)) so the two don't overlap.
       The ticker is a plain in-flow element (it scrolls away with the
       page, not pinned), so this offset only makes sense while it's
       still in view — .site-nav--past-ticker (toggled below) drops it
       back to 0 once the ticker has scrolled past, so the nav never
       floats over a blank gap. */
    top: var(--space-10);
  }

  .site-nav--home.site-nav--past-ticker {
    top: 0;
  }

  .site-nav-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(39.6px);
    -webkit-backdrop-filter: blur(39.6px);
    border: 1px solid #e2e2e5;
    border-radius: 999px;
    padding: 10px 12px 10px 24px;
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.05),
      var(--shadow-sm);
    max-width: 1440px;
    margin: 0 auto;
  }

  .site-nav--home .site-nav-inner {
    /* Use the same translucent background as other pages */
  }

  .site-nav-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--color-accent-900);
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: 17px;
    letter-spacing: 0.01em;
  }

  .site-nav-links {
    display: flex;
    gap: 30px;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }

  .site-nav-links a {
    color: var(--color-neutral-700);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .site-nav-links a:hover,
  .site-nav-links a[aria-current="page"] {
    color: var(--color-accent-900);
    font-weight: 800;
  }

  .site-nav-actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .site-nav-menu {
    display: none;
  }

  .site-nav-cta {
    display: inline-flex;
    align-items: center;
    padding: 12px 26px;
    background: var(--color-accent);
    color: #fff;
    border-radius: 999px;
    text-decoration: none;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    transition: background-color var(--transition-fast);
  }

  .site-nav-cta:hover {
    /* --color-accent and --color-accent-600 are the same value, so hover
       needs a distinct step (700) to actually be visible. */
    background: var(--color-accent-700);
  }

  @media (max-width: 900px) {
    .site-nav {
      padding: var(--space-4) var(--space-4);
    }

    .site-nav-inner {
      gap: 16px;
      padding: 8px 12px 8px 16px;
    }

    .site-nav-links,
    .site-nav-cta {
      display: none;
    }

    .site-nav-actions {
      gap: var(--space-2);
    }

    .site-nav-menu {
      display: block;
    }

    .site-nav-menu summary {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      border: 1px solid var(--color-neutral-400);
      border-radius: 50%;
      color: var(--color-accent-900);
      cursor: pointer;
      list-style: none;
    }

    .site-nav-menu summary::-webkit-details-marker {
      display: none;
    }

    .site-nav-menu-panel {
      position: absolute;
      top: calc(100% + var(--space-2));
      right: 0;
      left: 0;
      display: flex;
      flex-direction: column;
      padding: var(--space-3);
      border: 1px solid var(--color-divider);
      border-radius: var(--radius-md);
      background: var(--color-bg);
      box-shadow: var(--shadow-md);
    }

    .site-nav-menu-panel a {
      padding: var(--space-3) var(--space-4);
      color: var(--color-neutral-700);
      text-decoration: none;
      font-size: var(--font-size-sm);
      font-weight: 700;
      transition:
        color var(--transition-fast),
        background-color var(--transition-fast);
    }

    .site-nav-menu-panel a:hover,
    .site-nav-menu-panel a[aria-current="page"] {
      color: var(--color-accent-900);
      background: var(--color-surface);
    }
  }
</style>

<script>
  let lastScroll = 0;
  const nav = document.getElementById("site-nav");
  // Only present on Home — drives .site-nav--past-ticker so the nav's
  // above-the-fold offset (reserved for the ticker) drops away once the
  // ticker itself has actually scrolled out of view, instead of staying
  // fixed and leaving a blank gap when the nav reappears on scroll-up.
  const ticker = document.querySelector<HTMLElement>(".dates-ticker");

  if (nav) {
    const syncPastTicker = () => {
      if (!ticker) return;
      nav.classList.toggle(
        "site-nav--past-ticker",
        window.pageYOffset >= ticker.offsetHeight,
      );
    };

    syncPastTicker();

    window.addEventListener(
      "scroll",
      () => {
        const currentScroll = window.pageYOffset;
        syncPastTicker();

        if (currentScroll <= 0) {
          nav.style.transform = "translateY(0)";
          return;
        }

        if (currentScroll > lastScroll && currentScroll > 80) {
          // Scroll Down
          nav.style.transform = "translateY(-100%)";
        } else {
          // Scroll Up
          nav.style.transform = "translateY(0)";
        }
        lastScroll = currentScroll;
      },
      { passive: true },
    );
  }
</script>
