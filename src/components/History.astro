---
import { history } from "../data/history";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations, type Lang } from "../i18n/utils";
import Button from "./Button.astro";
import { site } from "../data/site";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const recentEditions = history.slice(0, 3);
const earlierEditions = history.slice(3);
---

<header class="history-header">
  <div class="eyebrow">{t("history.eyebrow")}</div>

  <h1>{t("history.title")}</h1>

  <p>{t("history.description")}</p>
</header>

<section class="recent-editions">
  <h2>{t("history.recent.title")}</h2>

  <p class="section-description">
    {t("history.recent.description")}
  </p>

  <div class="recent-list">
    {
      recentEditions.map((edition) => (
        <a
          href={edition.url}
          target="_blank"
          rel="noopener noreferrer"
          class="recent-edition"
        >
          <div class="banner">
            <img src={edition.banner} alt={edition.alt} />
          </div>

          <div class="edition-meta">
            <span class="year">SEI'{String(edition.year).slice(-2)}</span>

            <span class="date">{edition.dateLabel}</span>

            <span class="visit">{t("history.visitEdition")} →</span>
          </div>
        </a>
      ))
    }
  </div>
</section>

<section class="earlier-editions">
  <h2>{t("history.earlier.title")}</h2>

  <p class="section-description">
    {t("history.earlier.description")}
  </p>

  <div class="earlier-list">
    {
      earlierEditions.map((edition) => (
        <a
          href={edition.url}
          target="_blank"
          rel="noopener noreferrer"
          class="earlier-edition"
        >
          <span class="year">SEI'{String(edition.year).slice(-2)}</span>

          <span class="description">{edition.description}</span>

          <span class="visit">{t("history.visitEdition")} →</span>
        </a>
      ))
    }
  </div>
</section>

<section class="submission-cta">
  <div>
    <h2>{t("history.cta.title")}</h2>

    <p>{t("history.cta.description")}</p>
  </div>

  {
    site.pages.submissions && (
      <Button
        variant="primary"
        href={getRelativeLocaleUrl(lang, site.pages.submissions)}
      >
        {t("history.cta.button")}
      </Button>
    )
  }
</section>

<style>
  .history-header {
    padding: var(--space-8) var(--space-8) var(--space-6);
  }

  .history-header h1 {
    max-width: 640px;
    margin: 0 0 var(--space-6);
  }

  .history-header p {
    max-width: 560px;
    margin: 0;
    opacity: 0.75;
  }

  .eyebrow {
    margin-bottom: var(--space-4);
    color: var(--color-neutral-700);
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .recent-editions {
    padding: var(--space-4) var(--space-8) 0;
  }

  .recent-editions h2,
  .earlier-editions h2 {
    margin: 0 0 var(--space-2);
  }

  .section-description {
    max-width: 520px;
    margin: 0 0 var(--space-8);
    opacity: 0.7;
  }

  .recent-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .recent-edition {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .banner {
    width: 100%;
    aspect-ratio: 2560 / 810;
    margin-bottom: var(--space-4);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .banner img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .edition-meta {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    margin-bottom: var(--space-2);
  }

  .year {
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
  }

  .date {
    color: var(--color-neutral-700);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  .visit {
    margin-left: auto;
    color: var(--color-accent-700);
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .earlier-editions {
    padding: var(--space-8) var(--space-8) 0;
  }

  .earlier-list {
    border-top: 1px solid var(--color-divider);
  }

  .earlier-edition {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: var(--space-8);
    align-items: center;
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--color-divider);
    color: inherit;
    text-decoration: none;
  }

  .earlier-edition .description {
    opacity: 0.65;
  }

  .submission-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    margin: var(--space-8) var(--space-8) 0;
    padding: var(--space-8) 0;
    border-top: 1px solid var(--color-divider);
  }

  .submission-cta h2 {
    max-width: 520px;
    margin: 0 0 var(--space-3);
  }

  .submission-cta p {
    max-width: 460px;
    margin: 0;
    opacity: 0.75;
  }

  @media (max-width: 768px) {
    .history-header,
    .recent-editions,
    .earlier-editions {
      padding-left: var(--space-6);
      padding-right: var(--space-6);
    }

    .history-header {
      padding-top: var(--space-8);
      padding-bottom: var(--space-6);
    }

    .recent-editions {
      padding-top: var(--space-4);
    }

    .earlier-editions {
      padding-top: var(--space-8);
    }

    .recent-list {
      gap: var(--space-6);
    }

    .edition-meta {
      flex-wrap: wrap;
    }

    .visit {
      margin-left: auto;
      white-space: normal;
      text-align: right;
    }

    .earlier-edition {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-3) var(--space-4);
    }

    .earlier-edition .description {
      grid-column: 1 / -1;
    }

    .submission-cta {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-6);
      margin-left: var(--space-6);
      margin-right: var(--space-6);
      padding-top: var(--space-8);
      padding-bottom: var(--space-8);
    }
  }
</style>
