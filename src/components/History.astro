---
import history from "../data/history.json";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations, type Lang } from "../i18n/utils";
import Button from "./Button.astro";
import site from "../data/site.json";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const recentEditions = history.slice(0, 3);
const earlierEditions = history.slice(3);
---

<header class="history-header">
  <div class="eyebrow">{t("history.eyebrow")}</div>

  <h1>{t("history.title")}</h1>

  <p>{t("history.description")}</p>
</header>

<section class="recent-editions">
  <h2>{t("history.recent.title")}</h2>

  <p class="section-description">
    {t("history.recent.description")}
  </p>

  <div class="recent-list">
    {
      recentEditions.map((edition) => (
        <a
          href={edition.url}
          target="_blank"
          rel="noopener noreferrer"
          class="recent-edition"
        >
          <div class="banner">
            <img src={edition.banner} alt={edition.alt} />
          </div>

          <div class="edition-meta">
            <span class="year">SEI'{String(edition.year).slice(-2)}</span>

            <span class="date">{edition.dateLabel || ""}</span>

            <span class="visit">{t("history.visitEdition")} →</span>
          </div>
        </a>
      ))
    }
  </div>
</section>

<section class="earlier-editions">
  <h2>{t("history.earlier.title")}</h2>

  <p class="section-description">
    {t("history.earlier.description")}
  </p>

  <div class="earlier-list">
    {
      earlierEditions.map((edition) => (
        <a
          href={edition.url}
          target="_blank"
          rel="noopener noreferrer"
          class="earlier-edition"
        >
          <span class="year">SEI'{String(edition.year).slice(-2)}</span>

          <span class="description">{edition.description || ""}</span>

          <span class="visit">{t("history.visitEdition")} →</span>
        </a>
      ))
    }
  </div>
</section>

<section class="submission-cta">
  <div>
    <h2>{t("history.cta.title")}</h2>

    <p>{t("history.cta.description")}</p>
  </div>

  {
    site.pages.submissions && (
      <Button
        variant="primary"
        href={getRelativeLocaleUrl(lang, site.pages.submissions)}
      >
        {t("history.cta.button")}
      </Button>
    )
  }
</section>

<style>
  .history-header {
    padding: 72px 56px 56px;
  }

  .eyebrow {
    margin-bottom: 22px;
    color: var(--color-neutral-700);
    font-size: 11px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .history-header h1 {
    max-width: 640px;
    margin: 0 0 28px;
    font-size: 60px;
    line-height: 1.05;
    font-weight: 800;
  }

  .history-header p {
    max-width: 560px;
    margin: 0;
    font-size: 15px;
    line-height: 1.75;
    opacity: 0.75;
  }

  .recent-editions {
    padding: 16px 56px 0;
  }

  .recent-editions h2,
  .earlier-editions h2 {
    margin: 0 0 10px;
    font-size: 32px;
    line-height: 1.2;
    font-weight: 800;
  }

  .section-description {
    max-width: 520px;
    margin: 0 0 36px;
    font-size: 14px;
    line-height: 1.75;
    opacity: 0.7;
  }

  .recent-list {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .recent-edition {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .banner {
    width: 100%;
    aspect-ratio: 2560 / 810;
    margin-bottom: 18px;
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .banner img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .edition-meta {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 6px;
  }

  .year {
    font-size: 22px;
    font-weight: 800;
  }

  .date {
    color: var(--color-neutral-700);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  .visit {
    margin-left: auto;
    color: var(--color-accent-700);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .earlier-editions {
    padding: 72px 56px 0;
  }

  .earlier-list {
    border-top: 1px solid var(--color-divider);
  }

  .earlier-edition {
    display: grid;
    grid-template-columns: 110px 1fr auto;
    gap: 32px;
    align-items: center;
    padding: 26px 0;
    border-bottom: 1px solid var(--color-divider);
    color: inherit;
    text-decoration: none;
  }

  .earlier-edition .description {
    font-size: 13px;
    line-height: 1.6;
    opacity: 0.65;
  }

  .submission-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 56px;
    margin: 80px 56px 0;
    padding: 56px 0 72px;
    border-top: 1px solid var(--color-divider);
  }

  .submission-cta h2 {
    max-width: 520px;
    margin: 0 0 12px;
    font-size: 30px;
    line-height: 1.2;
    font-weight: 800;
  }

  .submission-cta p {
    max-width: 460px;
    margin: 0;
    font-size: 14px;
    line-height: 1.75;
    opacity: 0.75;
  }
</style>
