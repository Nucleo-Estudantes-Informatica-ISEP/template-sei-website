---
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations, type Lang } from "../i18n/utils";
import Button from "./Button.astro";
import { site } from "../data/site";
import { committees, type CommitteesConfig } from "../data/committees";

interface Props {
  lang: Lang;
}

type CommitteeMember = CommitteesConfig["organizing"][number];

const { lang } = Astro.props;
const t = useTranslations(lang);

const technicalScientificCommittee: CommitteeMember[] = committees.scientific;
const organizationCommittee: CommitteeMember[] = committees.organizing;

const description = t("committees.description").replace(
  "{edition}",
  site.edition.name,
);
const ctaHeading = t("committees.ctaHeading").replace(
  "{edition}",
  site.edition.name,
);
---

<section class="committees-page">
  <header class="committees-header">
    <div class="eyebrow">{t("committees.eyebrow")}</div>
    <h1>{t("committees.heading")}</h1>
    <p>{description}</p>
  </header>

  <section class="committee-section">
    <h2>{t("committees.technicalHeading")}</h2>
    <p class="committee-section-description">
      {t("committees.technicalDescription")}
    </p>
    <div class="committee-grid">
      {
        technicalScientificCommittee.map((member: CommitteeMember) => (
          <div class="committee-row">
            <span class="member-name">{member.name}</span>
            <span class="member-org">{member.org}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="committee-section">
    <h2>{t("committees.organizationHeading")}</h2>
    <p class="committee-section-description">
      {t("committees.organizationDescription")}
    </p>
    <div class="committee-grid">
      {
        organizationCommittee.map((member: CommitteeMember) => (
          <div class="committee-row">
            <span class="member-name">{member.name}</span>
            <span class="member-org">{member.org}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="committees-cta">
    <div>
      <h2>{ctaHeading}</h2>
      <p>{t("committees.ctaDescription")}</p>
    </div>
    <Button
      variant="primary"
      href={getRelativeLocaleUrl(lang, site.pages.submissions)}
    >
      {t("committees.ctaButton")}
    </Button>
  </section>
</section>

<style>
  .committees-page {
    width: 100%;
  }

  .committees-header {
    padding: var(--space-18) var(--space-14) var(--space-14);
  }

  .eyebrow {
    font-size: var(--font-size-xs);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-neutral-700);
    margin-bottom: var(--space-6);
  }

  .committees-header h1 {
    font-size: var(--font-size-2xl);
    line-height: 1.05;
    margin: 0 0 var(--space-7);
    max-width: 640px;
  }

  .committees-header p {
    line-height: 1.75;
    opacity: 0.75;
    max-width: 560px;
    margin: 0;
  }

  .committee-section {
    padding: var(--space-4) var(--space-14) 0;
  }

  .committee-section + .committee-section {
    padding-top: var(--space-18);
  }

  .committee-section-description {
    font-size: var(--font-size-md);
    line-height: 1.75;
    opacity: 0.7;
    max-width: 520px;
    margin: 0 0 var(--space-9);
  }

  .committee-grid {
    border-top: 1px solid var(--color-divider);
    padding-top: var(--space-2);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0 var(--space-14);
  }

  .committee-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-divider);
  }

  .member-name {
    font-size: var(--font-size-md);
  }

  .member-org {
    font-size: var(--font-size-2xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.55;
    text-align: right;
  }

  .committees-cta {
    margin: var(--space-20) var(--space-14) 0;
    padding: var(--space-14) 0 var(--space-18);
    border-top: 1px solid var(--color-divider);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-14);
  }

  .committees-cta h2 {
    font-size: var(--font-size-lg);
    line-height: 1.2;
    margin: 0 0 var(--space-3);
    max-width: 520px;
  }

  .committees-cta p {
    font-size: var(--font-size-md);
    line-height: 1.75;
    opacity: 0.75;
    max-width: 460px;
    margin: 0;
  }

  .committees-cta :global(.btn) {
    flex: none;
  }

  @media (max-width: 900px) {
    .committee-grid {
      grid-template-columns: 1fr;
    }

    .committees-cta {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 640px) {
    .committees-header {
      padding: var(--space-10) var(--space-4) var(--space-6);
    }

    .committee-section {
      padding: var(--space-4) var(--space-4) 0;
    }

    .committee-section + .committee-section {
      padding-top: var(--space-10);
    }

    .committees-cta {
      margin: var(--space-10) var(--space-4) 0;
      padding: var(--space-6) 0 var(--space-10);
      gap: var(--space-6);
    }

    .committee-row {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-1);
    }

    .member-org {
      text-align: left;
    }
  }
</style>
