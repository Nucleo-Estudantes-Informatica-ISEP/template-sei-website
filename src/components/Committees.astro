---
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations, type Lang } from "../i18n/utils";
import Button from "./Button.astro";
import { site } from "../data/site";
import committees from "../data/committees.json";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const { technicalScientificCommittee, organizationCommittee } = committees;

const description = t("committees.description").replace(
  "{edition}",
  site.edition.name,
);
const ctaHeading = t("committees.ctaHeading").replace(
  "{edition}",
  site.edition.name,
);
---

<section class="committees-page">
  <header class="committees-header">
    <div class="eyebrow">{t("committees.eyebrow")}</div>
    <h1>{t("committees.heading")}</h1>
    <p>{description}</p>
  </header>

  <section class="committee-section">
    <h2>{t("committees.technicalHeading")}</h2>
    <p class="committee-section-description">
      {t("committees.technicalDescription")}
    </p>
    <div class="committee-grid">
      {
        technicalScientificCommittee.map((member) => (
          <div class="committee-row">
            <span class="member-name">{member.name}</span>
            <span class="member-org">{member.affiliation}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="committee-section">
    <h2>{t("committees.organizationHeading")}</h2>
    <p class="committee-section-description">
      {t("committees.organizationDescription")}
    </p>
    <div class="committee-grid">
      {
        organizationCommittee.map((member) => (
          <div class="committee-row">
            <span class="member-name">{member.name}</span>
            <span class="member-org">{member.affiliation}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="committees-cta">
    <div>
      <h2>{ctaHeading}</h2>
      <p>{t("committees.ctaDescription")}</p>
    </div>
    <Button
      variant="primary"
      href={getRelativeLocaleUrl(lang, site.pages.submissions)}
    >
      {t("committees.ctaButton")}
    </Button>
  </section>
</section>

<style>
  .committees-page {
    width: 100%;
  }

  .committees-header {
    padding: 72px 56px 56px;
  }

  .eyebrow {
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-neutral-700);
    margin-bottom: 22px;
  }

  .committees-header h1 {
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: 60px;
    line-height: 1.05;
    margin: 0 0 28px;
    max-width: 640px;
  }

  .committees-header p {
    font-size: 15px;
    line-height: 1.75;
    opacity: 0.75;
    max-width: 560px;
    margin: 0;
  }

  .committee-section {
    padding: 16px 56px 0;
  }

  .committee-section + .committee-section {
    padding-top: 72px;
  }

  .committee-section h2 {
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: 32px;
    line-height: 1.2;
    margin: 0 0 10px;
  }

  .committee-section-description {
    font-size: 14px;
    line-height: 1.75;
    opacity: 0.7;
    max-width: 520px;
    margin: 0 0 36px;
  }

  .committee-grid {
    border-top: 1px solid var(--color-divider);
    padding-top: 8px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0 56px;
  }

  .committee-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--color-divider);
  }

  .member-name {
    font-size: 14px;
  }

  .member-org {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.55;
    white-space: nowrap;
  }

  .committees-cta {
    margin: 80px 56px 0;
    padding: 56px 0 72px;
    border-top: 1px solid var(--color-divider);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 56px;
  }

  .committees-cta h2 {
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: 30px;
    line-height: 1.2;
    margin: 0 0 12px;
    max-width: 520px;
  }

  .committees-cta p {
    font-size: 14px;
    line-height: 1.75;
    opacity: 0.75;
    max-width: 460px;
    margin: 0;
  }

  .committees-cta :global(.btn) {
    flex: none;
  }

  @media (max-width: 900px) {
    .committee-grid {
      grid-template-columns: 1fr;
    }

    .committees-cta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
