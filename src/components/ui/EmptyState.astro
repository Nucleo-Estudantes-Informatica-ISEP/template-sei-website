---
/**
 * SEI — empty state. Shown when a collection has no published content yet
 * (speakers, photos, etc.), so the system stays graceful while data fills in.
 */
import Icon from "./Icon.astro";

interface Props {
  title: string;
  body: string;
}

const { title, body } = Astro.props;
---

<div class="empty-state">
  <span class="empty-state__icon">
    <Icon name="file" size={22} />
  </span>
  <h3>{title}</h3>
  <p>{body}</p>
  <slot />
</div>

<style>
  .empty-state {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 0.7rem;
    padding: clamp(3rem, 8vw, 5rem) 1.5rem;
    border: 1.5px dashed var(--line-strong);
    border-radius: var(--radius-l);
    background: color-mix(in srgb, var(--surface) 60%, transparent);
  }

  .empty-state__icon {
    display: grid;
    place-items: center;
    width: 3.4rem;
    height: 3.4rem;
    border-radius: var(--radius-m);
    background: var(--accent-soft);
    color: var(--accent-deep);
  }

  .empty-state h3 {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 560;
  }

  .empty-state p {
    color: var(--muted);
    max-width: 30rem;
  }
</style>
