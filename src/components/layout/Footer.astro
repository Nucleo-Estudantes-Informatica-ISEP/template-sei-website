---
/**
 * SEI — global footer.
 * Institutional partner logos sit on a light band; the footer itself is ink.
 */
import { site, resolveImage } from "../../data";
import Icon from "../ui/Icon.astro";
import LogoMark from "../ui/LogoMark.astro";

const { name, shortName, editionLabel, footer } = site;

const partners: Array<{ label: string; key: string; url: string }> = [
  { label: "DEI", key: "deiLogo", url: "https://www.dei.isep.ipp.pt/" },
  { label: "NEI", key: "neiLogo", url: "https://www.nei-isep.org/" },
  {
    label: "ISEP",
    key: "isepLogoWeb",
    url: "https://www.isep.ipp.pt/",
  },
];

const sponsorImg = resolveImage("sponsor");

const currentYear = new Date().getFullYear();
---

<footer>
  <div class="partners">
    <div class="container partners__grid">
      <div class="partners__group">
        <p class="partners__label">Organizado por</p>
        <div class="partners__row">
          {
            partners.map((p) => {
              const img = resolveImage(p.key);
              return (
                <a
                  class="partners__link"
                  href={p.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${p.label} — abrir website`}
                >
                  {img && (
                    <img
                      src={img.src}
                      alt={p.label}
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                </a>
              );
            })
          }
        </div>
      </div>

      <div class="partners__group">
        <p class="partners__label">Agradecimentos</p>
        <div class="partners__row">
          {
            sponsorImg && (
              <img
                class="partners__sponsor"
                src={sponsorImg.src}
                alt="Apoio"
                loading="lazy"
                decoding="async"
              />
            )
          }
        </div>
      </div>
    </div>
  </div>

  <div class="footer on-ink">
    <div class="container footer__grid">
      <div class="footer__col footer__col--identity">
        <a class="footer__brand" href="/">
          <LogoMark size={34} alt="" />
          <span>
            <strong>{shortName}</strong>
            <em>{editionLabel}</em>
          </span>
        </a>
        <p class="footer__blurb">{footer.blurb}</p>
        <p class="footer__address">{footer.address}</p>
      </div>

      <div class="footer__col">
        <h3>Contacto</h3>
        <ul class="footer__links" role="list">
          {
            footer.contacts.map((c) => (
              <li>
                <a
                  href={c.url}
                  class="footer__contact"
                  {...(c.url.startsWith("http")
                    ? { target: "_blank", rel: "noopener noreferrer" }
                    : {})}
                >
                  {c.label}
                  {c.url.startsWith("http") && (
                    <Icon name="external" size={13} />
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="container footer__bottom">
      <p>
        © {currentYear}
        {name} · {site.location}
      </p>
      <p class="footer__edition">SEI · {editionLabel}</p>
    </div>
  </div>
</footer>

<style>
  /* Partner logos */
  .partners {
    border-top: 1px solid var(--line);
    background: var(--surface);
    padding-block: 1.25rem;
  }

  .partners__grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .partners__label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.7rem;
  }

  .partners__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.6rem;
    min-height: 2.1rem;
  }

  .partners__sponsor {
    max-height: 2.6rem;
    width: auto;
    opacity: 0.62;
    filter: grayscale(1);
    transition:
      opacity var(--dur-m) var(--ease-out),
      filter var(--dur-m) var(--ease-out);
  }

  .partners__sponsor:hover {
    opacity: 1;
    filter: grayscale(0);
  }

  .partners__link {
    display: inline-flex;
    align-items: center;
    opacity: 0.62;
    filter: grayscale(1);
    transition:
      opacity var(--dur-m) var(--ease-out),
      filter var(--dur-m) var(--ease-out),
      transform var(--dur-m) var(--ease-out);
  }

  .partners__link:hover {
    opacity: 1;
    filter: grayscale(0);
    transform: translateY(-2px);
  }

  .partners__link img {
    max-height: 2.1rem;
    width: auto;
  }

  /* Footer body */
  .footer {
    padding-top: 2.75rem;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    padding-bottom: 2rem;
  }

  .footer__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--ink-paper);
    margin-bottom: 0.9rem;
  }

  .footer__brand span {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .footer__brand strong {
    font-family: var(--font-mono);
    font-size: 1.02rem;
    letter-spacing: 0.14em;
  }

  .footer__brand em {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .footer__blurb {
    color: var(--ink-2);
    font-size: 0.92rem;
    max-width: 26rem;
    margin-bottom: 0.7rem;
  }

  .footer__address {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.7;
    color: var(--muted);
    white-space: pre-line;
  }

  .footer__col h3 {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.8rem;
  }

  .footer__links {
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }

  .footer__contact {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    color: var(--ink-2);
    text-decoration: none;
    font-size: 0.92rem;
    transition: color var(--dur-s);
  }

  .footer__contact:hover {
    color: var(--ink-paper);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    padding-block: 1rem;
    border-top: 1px solid var(--ink-line);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .partners__grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .footer__grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }
</style>
