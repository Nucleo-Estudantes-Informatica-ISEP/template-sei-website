---
import "../styles/tokens.css";
import "../styles/primitives.css";
import "../styles/styles.override.css";
import { site } from "../data/site";
import { getLangFromUrl } from "../i18n/utils";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import BackToTop from "../components/BackToTop.astro";

const lang = getLangFromUrl(Astro.url);
const currentPath = Astro.url.pathname
  .replace(new RegExp(`^/${lang}/?`), "")
  .replace(/\/$/, "");
const isHome = currentPath === site.pages.home || currentPath === "";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{site.edition.name}</title>
  </head>
  <body>
    <div id="top">
      <Nav />
      <div class:list={["page-content", { "is-home": isHome }]}>
        <slot />
        <Footer />
      </div>
    </div>
    <BackToTop />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  /* full-bleed sections (e.g. the home hero) intentionally use 100vw, which
     overflows by the scrollbar's width unless horizontal overflow is clipped.
     Clipping here rather than on html/body avoids a CSS Overflow quirk: on the
     root, setting overflow-x alone forces overflow-y to compute as "auto" too,
     which turns body into its own scroll container instead of the viewport
     (breaking window.scrollTo and back-to-top). #top has no explicit height,
     so it never actually overflows vertically and this stays a no-op there. */
  #top {
    overflow-x: hidden;
  }

  .page-content {
    max-width: 1440px;
    margin: 0 auto;
  }
  .page-content:not(.is-home) {
    padding-top: 100px;
  }
</style>
