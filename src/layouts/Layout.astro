---
import "../styles/tokens.css";
import "../styles/primitives.css";
import "../styles/styles.override.css";

import { site } from "../data/site";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import BackToTop from "../components/BackToTop.astro";
import Seo from "../components/Seo.astro";

import seiIconMark from "../assets/sei-icon-mark.png";

interface Props {
  page:
    | "home"
    | "program"
    | "speakers"
    | "committees"
    | "submissions"
    | "history"
    | "registration";
}

const { page } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const seoPages = {
  home: {
    title: site.edition.name,
    description: t("home.hero.description"),
  },
  program: {
    title: t("program.eyebrow"),
    description: t("program.intro"),
  },
  speakers: {
    title: t("speakers.eyebrow"),
    description: t("speakers.description"),
  },
  committees: {
    title: t("committees.eyebrow"),
    description: t("committees.description"),
  },
  submissions: {
    title: t("submissions.eyebrow"),
    description: t("submissions.description"),
  },
  history: {
    title: t("history.eyebrow"),
    description: t("history.description"),
  },
  registration: {
    title: t("registration.eyebrow"),
    description: t("registration.description"),
  },
} as const;

const seo = seoPages[page];

const title =
  page === "home" ? seo.title : `${seo.title} | ${site.edition.name}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />

    <link rel="icon" type="image/png" href={seiIconMark.src} />

    <meta name="generator" content={Astro.generator} />

    <Seo
      title={title}
      description={seo.description}
      ogImage={site.seo.ogImage}
      url={Astro.url}
    />
  </head>

  <body>
    <div id="top">
      <Nav />
      <slot />
      <Footer />
    </div>

    <BackToTop />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
