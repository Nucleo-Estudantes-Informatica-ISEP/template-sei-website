# Optional. Enables translating EasyChair-synced Program page content per
# locale (see AGENTS.md "Program page translations", #97) via Google Cloud
# Translation (Basic tier). Only read at build/dev time, never sent to the
# client. Unset — the default — the original scraped text is shown as-is in
# both locales; nothing else in this repo currently reads an env var.
GOOGLE_TRANSLATE_API_KEY=
